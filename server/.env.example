# ───────────────────────────────────────────────────────────────
# ZeroSignal server environment. Copy to `server/.env` (git-ignored).
# Every secret here is BACKEND-ONLY. Nothing in /client ever sees them.
# ───────────────────────────────────────────────────────────────

# development | staging | production
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (database name: zerosignal).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/zerosignal?retryWrites=true&w=majority

# Access-token signing secret (32+ chars in production). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access tokens are short-lived; the refresh cookie keeps people signed in.
ACCESS_TOKEN_TTL=15m

# Alert signing (Ed25519). 32-byte hex seed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALERT_SIGNING_SEED=

# Comma-separated browser origins allowed by CORS + Socket.IO (your Vercel URL in production).
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where links in emails (reset / invite) point. Defaults to the first CLIENT_ORIGINS entry.
APP_BASE_URL=

# ── Sessions (refresh cookie) ──
REFRESH_TTL_DAYS=30
# lax works with the Vercel /api rewrite (same-site). Use `none` only if the browser talks to the API cross-site.
COOKIE_SAMESITE=lax
# Defaults to true in production. Needs HTTPS.
COOKIE_SECURE=
# Password hashing (argon2id). Defaults are the OWASP baseline; leave alone.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Lockout: after N failures, back off exponentially (minutes).
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_MINUTES=1
LOCKOUT_MAX_MINUTES=30
RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=72
AUDIT_RETENTION_DAYS=365

# ── Email (password reset + admin invites) ──
# console = print links to the server log (dev). smtp = real email via nodemailer.
MAIL_TRANSPORT=console
SMTP_URL=
MAIL_FROM="ZeroSignal <no-reply@example.org>"

# ── Groq (AI). Empty = labelled rule-based fallback ──
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=8000

# ── Rate limits ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=20
# Behind Render's proxy set this to 1 so rate limiting sees real client IPs.
TRUST_PROXY=0

# ── Real streaming (all optional; the simulated feed is always the last resort) ──
# Fallback order. `simulated` is always appended.
MEDIA_PROVIDERS=livekit,hls,simulated
# Salt for unguessable room names and signed HLS links. Defaults to JWT_SECRET.
MEDIA_ROOM_SALT=
# LiveKit (WebRTC). Free cloud tier: https://cloud.livekit.io  → Settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SEC=3600
# HLS: FFmpeg encodes a 720/480/240/audio ladder.
FFMPEG_PATH=ffmpeg
# Empty = segments served from this API (local/demo only). Production: a CDN / object-storage base URL.
HLS_BASE_URL=
HLS_OUTPUT_DIR=
# Optional looping source video for the HLS ladder (server operator choice).
HLS_SOURCE_FILE=

# ── Hosting without a shell (Render free tier): configure from the dashboard instead of the CLI ──
# Creates this admin on first boot (if it does not exist) and prints a ONE-TIME setup link in the server log.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# true = load the sample history once on first boot (needs SEED_EMAIL_DOMAIN below). Never re-runs.
SEED_ON_BOOT=false

# ── Sample history (CLI, or SEED_ON_BOOT above; see README "Pre-loaded sample history") ──
# `npm run seed` needs a domain for the sample people's email addresses. Passwords come from here or are generated.
SEED_EMAIL_DOMAIN=responders.example.org
# Optional. Must satisfy the password policy (10+ chars). If empty, a random one is generated and printed ONCE.
SEED_USER_PASSWORD=
