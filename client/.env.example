# Client environment (Vite). Copy to client/.env.local — only VITE_* values reach the browser.
# NEVER put secrets here: everything in a Vite client bundle is public.

# REST base URL. Leave EMPTY locally (Vite proxies /api, /media and /socket.io to :5000).
# On Vercel leave it EMPTY too and use the /api rewrite in client/vercel.json (keeps the refresh cookie first-party).
VITE_API_URL=

# Socket.IO connects straight to the API (Vercel cannot proxy WebSockets). Locally leave empty.
# On Vercel set it to your Render URL, e.g. https://zerosignal-api.onrender.com
VITE_SOCKET_URL=
